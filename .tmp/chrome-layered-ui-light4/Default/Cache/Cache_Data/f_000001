/* ============ Layered target UI pass ============ */

:root {
  --bg: #ededed;
  --bg-raised: rgba(226, 226, 226, 0.62);
  --bg-raised-solid: transparent;
  --glass-sheen-1: rgba(255, 255, 255, 0.36);
  --glass-sheen-2: rgba(214, 214, 214, 0.4);
  --border: rgba(255, 255, 255, 0.26);
  --accent: #8290ff;
  --accent-soft: rgba(130, 144, 255, 0.2);
  --rail-w: 52px;
  --sidebar-w: clamp(330px, 36vw, 410px);
  --content-max: min(1120px, 76vw);
  --shell-pad-y: clamp(38px, 7.6vh, 78px);
  --shell-pad-x: 0px;
  --radius-lg: 24px;
}

html,
body {
  background: var(--bg);
}

body {
  position: relative;
}

body::before,
body::after {
  content: "";
  position: fixed;
  z-index: 0;
  pointer-events: none;
  border-radius: 50%;
  background: radial-gradient(circle at 36% 28%, #aeb8ff 0%, #8796ee 48%, #7080de 100%);
  opacity: 0.72;
}

body::before {
  width: clamp(250px, 21vw, 390px);
  height: clamp(250px, 21vw, 390px);
  left: 36.5%;
  top: 34%;
  transform: translate(-50%, -50%);
}

body::after {
  width: clamp(110px, 9.5vw, 180px);
  height: clamp(110px, 9.5vw, 180px);
  left: 51%;
  top: 54%;
  transform: translate(-50%, -50%);
}

#app,
.layout,
.content-area,
.icon-rail,
.app-header,
.body-row,
.main,
.sidebar,
.dashboard {
  position: relative;
  z-index: 1;
}

@media (min-width: 720px) {
  #app {
    width: var(--content-max);
    max-width: var(--content-max);
    padding: var(--shell-pad-y) 0;
  }

  .layout {
    width: 100%;
    max-width: none;
  }

  .content-area {
    overflow: visible;
  }

  .app-header {
    position: relative;
    height: 62px;
    width: calc(100% + var(--rail-w) + 10px);
    margin-left: calc(-1 * (var(--rail-w) + 10px));
    padding: 0 0 12px;
    align-items: flex-end;
    overflow: visible;
  }

  .brand {
    position: absolute;
    left: 0;
    top: 0;
  }

  .header-menu {
    position: absolute;
    left: 0;
    bottom: 12px;
    display: flex;
    padding-left: 0;
  }

  .header-actions {
    margin-left: auto;
  }

  .body-row {
    gap: 10px;
    min-height: 0;
    height: calc(100dvh - (var(--shell-pad-y) * 2) - 62px);
    max-height: 760px;
  }

  .icon-rail {
    width: var(--rail-w);
    padding: 0;
    background: transparent;
  }

  .nav-scroll {
    padding-top: 5px;
    gap: 10px;
  }

  .nav-divider {
    height: auto;
    min-height: 26px;
  }

  .sidebar {
    width: var(--sidebar-w);
    gap: 12px;
  }
}

.icon-rail {
  background: transparent;
  border: 0;
  box-shadow: none;
}

.nav-icon {
  width: 39px;
  height: 39px;
  background: rgba(190, 190, 190, 0.92);
  color: #20232d;
  box-shadow: none;
}

.nav-icon.active {
  background: #94a2ff;
  color: #151827;
}

.header-icon-btn,
.header-date-badge {
  background: rgba(207, 211, 226, 0.62);
  color: #4051be;
}

.composer,
.tasklist-card,
.bento-cell,
.log,
.panel,
.files-tree,
.files-preview-pane,
.mini-calendar,
.detail-panel,
.week-grid-wrap,
.tasks-panel,
.accounts-view,
.settings-view,
.run-detail,
.calendar-view,
.files-view {
  background:
    linear-gradient(135deg, var(--glass-sheen-1), var(--glass-sheen-2)),
    var(--bg-raised);
  border-color: var(--border);
  box-shadow: none;
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
}

.bento-cell::before {
  content: none;
}

@media (min-width: 720px) {
  .composer {
    flex: 0 0 calc(55% - 6px);
    min-height: 0;
  }

  .tasklist-card {
    flex: 1 1 auto;
    min-height: 0;
  }

  #goal-form {
    min-height: 0;
    height: calc(100% - 24px);
  }
}

.dashboard {
  height: 100%;
  min-height: 0;
}

.bento-grid {
  height: 100%;
  min-height: 0;
  gap: 10px;
}

@media (min-width: 900px) {
  .bento-grid {
    grid-template-columns: minmax(0, 1.45fr) minmax(130px, 0.95fr);
    grid-template-rows: minmax(0, 0.56fr) minmax(0, 0.46fr) minmax(0, 1fr);
  }

  .bento-lavender {
    grid-column: 1;
    grid-row: 1;
  }

  .bento-orange {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  .bento-mint {
    grid-column: 1;
    grid-row: 2 / span 2;
  }

  .bento-forest {
    grid-column: 2;
    grid-row: 3;
  }
}

.bento-cell {
  min-height: 0;
  padding: clamp(16px, 2.3vw, 22px);
}

.bento-lavender {
  justify-content: flex-start;
}

.bento-orange {
  justify-content: flex-start;
}

.bento-orange .bento-label {
  color: var(--text);
  margin-bottom: 10px;
}

.bento-lavender .bento-detail-list {
  display: none;
}

.bento-lavender .bento-value-group {
  width: 100%;
}

.bento-lavender .bento-caption {
  margin-top: -4px;
  font-size: 16px;
  color: var(--text);
}

.bento-lavender .bento-subvalue {
  margin-top: auto;
  color: var(--success);
  text-align: right;
}

.bento-orange .bento-detail-list {
  max-height: none;
  margin-top: 0;
}

.bento-orange .bento-detail-item {
  padding: 0;
  margin: 0 0 8px;
  border-radius: 0;
}

.bento-orange .bento-detail-item-head {
  color: var(--error);
  font-size: 10px;
}

.bento-orange .bento-detail-goal,
.bento-orange .bento-detail-error {
  font-size: 9.5px;
  line-height: 1.18;
}

.bento-value {
  font-size: clamp(42px, 4.2vw, 58px);
  line-height: 0.95;
}

.bento-hero .bento-value {
  font-size: clamp(58px, 6vw, 76px);
}

.bento-caption,
.bento-subvalue,
.bento-label {
  font-size: clamp(11px, 1vw, 14px);
}

.bento-ring-wrap {
  right: clamp(18px, 2vw, 28px);
  bottom: clamp(16px, 2vw, 24px);
}

.bento-ring {
  width: clamp(94px, 9vw, 132px);
  height: clamp(94px, 9vw, 132px);
}

.bento-status-breakdown,
.bento-dept-breakdown {
  font-size: clamp(10px, 0.9vw, 13px);
}

@media (max-width: 899.98px) and (min-width: 720px) {
  :root {
    --content-max: min(92vw, 760px);
    --sidebar-w: min(42vw, 310px);
  }

  .body-row {
    height: calc(100dvh - (var(--shell-pad-y) * 2) - 62px);
  }

  .bento-grid {
    grid-template-columns: 1fr 0.72fr;
    grid-template-rows: minmax(110px, 0.56fr) minmax(90px, 0.46fr) minmax(170px, 1fr);
  }
}

@media (max-width: 719.98px) {
  body::before,
  body::after {
    content: none;
  }

  .icon-rail {
    background: rgba(237, 237, 237, 0.86);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
  }
}
