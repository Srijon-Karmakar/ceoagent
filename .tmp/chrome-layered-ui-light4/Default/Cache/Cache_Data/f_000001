  border-radius: 0;
  cursor: pointer;
  border: 0;
  transition: background 0.12s ease;
}

@media (hover: hover) {
  .run-item:hover {
    background: transparent;
  }
}

.run-item.selected {
  background: transparent;
  border-color: transparent;
}

.run-checkbox {
